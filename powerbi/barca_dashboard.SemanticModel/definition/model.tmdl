ref table 'warehouse vw_barca_player_events'
ref table 'warehouse vw_barca_goals_by_interval'
ref table 'warehouse vw_barca_fixtures'
ref table 'warehouse vw_live_current_score'
ref table 'warehouse vw_live_events_current'
ref table 'warehouse vw_model_metrics'
ref table 'warehouse vw_quality_results_latest'
ref table 'warehouse vw_quality_summary'
ref table 'warehouse vw_pipeline_health'

ref cultureInfo es-ES

