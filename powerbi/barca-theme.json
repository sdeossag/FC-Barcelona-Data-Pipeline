{
  "name": "Barca Data Pipeline",
  "dataColors": [
    "#004D98",
    "#A50044",
    "#1F7A5C",
    "#8C929B",
    "#C9A227",
    "#5B7FA6",
    "#B56576",
    "#B9B4A8"
  ],
  "background": "#FFFFFF",
  "secondaryBackground": "#EFEBE2",
  "foreground": "#16181D",
  "tableAccent": "#004D98",
  "good": "#1F7A5C",
  "neutral": "#8C929B",
  "bad": "#A50044",
  "maximum": "#004D98",
  "center": "#E6E2D9",
  "minimum": "#EEF2F7",
  "null": "#D8D3C8",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#16181D"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#16181D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#16181D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#6D7178"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E2D9"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#16181D"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6D7178"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6D7178"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E6E2D9"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6D7178"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6E2D9"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#E6E2D9"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#16181D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#16181D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6D7178"
              }
            },
            "fontSize": 9,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#16181D"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
