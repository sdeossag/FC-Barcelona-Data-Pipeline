{
  "name": "Barca Data Pipeline",
  "dataColors": [
    "#3D8BFF",
    "#F0527F",
    "#EDBB00",
    "#5C6B8A",
    "#00A3A3",
    "#9B7BFF",
    "#FF8A5C",
    "#8FA0C0"
  ],
  "background": "#131F38",
  "secondaryBackground": "#0B1426",
  "foreground": "#EEF2FA",
  "tableAccent": "#3D8BFF",
  "good": "#3D8BFF",
  "neutral": "#5C6B8A",
  "bad": "#F0527F",
  "maximum": "#3D8BFF",
  "center": "#24365C",
  "minimum": "#182847",
  "null": "#D8D3C8",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#EEF2FA"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#EEF2FA"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#EEF2FA"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#8FA0C0"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#131F38"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#24365C"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#EEF2FA"
              }
            },
            "background": {
              "solid": {
                "color": "#131F38"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8FA0C0"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8FA0C0"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#24365C"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8FA0C0"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#24365C"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#24365C"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#EEF2FA"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#EEF2FA"
              }
            },
            "backColor": {
              "solid": {
                "color": "#131F38"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#8FA0C0"
              }
            },
            "fontSize": 9,
            "background": {
              "solid": {
                "color": "#131F38"
              }
            },
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#EEF2FA"
              }
            },
            "background": {
              "solid": {
                "color": "#131F38"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F3EE"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}