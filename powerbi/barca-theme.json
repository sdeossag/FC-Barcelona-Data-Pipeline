{
  "name": "Barca Data Pipeline",
  "dataColors": [
    "#1B62C4",
    "#A50044",
    "#E2622E",
    "#6B4FA8",
    "#1E8E5A",
    "#0F6E8C",
    "#B03060",
    "#8A8A8A"
  ],
  "background": "#FFFFFF",
  "secondaryBackground": "#F7F7F5",
  "foreground": "#14161A",
  "tableAccent": "#A50044",
  "good": "#1E8E5A",
  "neutral": "#8A8A8A",
  "bad": "#C0392B",
  "maximum": "#A50044",
  "center": "#E4E4E1",
  "minimum": "#F7E4EC",
  "null": "#D9D9D6",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#14161A"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#14161A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#14161A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5B5F66"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#004D98"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#14161A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B5F66"
              }
            },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B5F66"
              }
            },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDEDEA"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B5F66"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEDEA"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#004D98"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#14161A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#14161A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "outline": "None"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#5B5F66"
              }
            },
            "fontSize": 10,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#14161A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
