# Football Data API
API_KEY_FOOTBALL=your_api_key_here

# PostgreSQL
POSTGRES_USER=samuel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=barca_warehouse
POSTGRES_HOST=postgres
