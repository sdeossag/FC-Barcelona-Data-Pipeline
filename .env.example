# Schema holding the analytics tables. Point this at another schema to run the
# pipeline in isolation, for example warehouse_test.
POSTGRES_SCHEMA=warehouse

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Kafka
KAFKA_BROKER_ID=1
KAFKA_PORT=9092