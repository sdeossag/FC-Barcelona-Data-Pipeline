# ============================================================
# Environment variables and secrets
# ============================================================

.env


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.pyo

.venv/
venv/
env/


# ============================================================
# Raw and staging data
# ============================================================

data/raw/*
data/staging/*


# ============================================================
# Airflow
# ============================================================

# docker-compose mounts ./logs into the containers, so task logs are written to
# the repository root and not under an airflow/ directory. Without this entry
# every DAG run adds files here, and the run_id folder names contain characters
# that Windows encodes in a way Git cannot round-trip cleanly.
logs/

airflow/logs/
airflow/plugins/
airflow/config/


# ============================================================
# PostgreSQL
# ============================================================

postgres-data/


# ============================================================
# Kafka
# ============================================================

kafka-data/
zookeeper-data/


# ============================================================
# IDE
# ============================================================

.vscode/
.idea/


# ============================================================
# Operating system
# ============================================================

.DS_Store
Thumbs.db


# ============================================================
# Trained models
# ============================================================

# Serialised models are large binaries that git cannot diff, and they are
# reproducible: scripts/train_model.py rebuilds them from the warehouse. The
# metadata JSON beside each one is small and text, so it stays tracked and
# records which data produced which accuracy.
models/*.pkl
models/*.joblib


# ============================================================
# Power BI temporary files
# ============================================================

*.tmp

# Local copies of the report taken before a redesign. They are binary and
# reproducible from Git history, so they stay out of version control.
powerbi/backups/
# Power BI Desktop local state: cached data and per-machine settings.
# Both are regenerated on open and would leak local paths or imported rows.
**/.pbi/cache.abf
**/.pbi/localSettings.json
